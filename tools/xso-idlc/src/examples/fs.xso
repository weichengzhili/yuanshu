@module(fs)
@version(1)

@available(added=1)
enum OpenFlags : u32 {
    READ   = 0x01,
    WRITE  = 0x02,
    CREATE = 0x04,
    TRUNC  = 0x08,
    APPEND = 0x10,
    EXCL   = 0x20,
}

@available(added=1)
error FsError : i32 {
    NotFound = 2,
    NotDir   = 20,
    IsDir    = 21,
    Inval    = 22,
    NoMem    = 12,
    Perm     = 1,
}

@available(added=1)
type Fd = i32;

// 共享结构体：按值传递
@available(added=1)
struct FileStat {
    @field(1) ino:   u64,
    @field(2) size:  i64,
    @field(3) mode:  u32,
    @field(4) nlink: u32,
}

// 不透明接口：字段隐藏，只能通过指针
@opaque
interface Vfs {
    // 借用 self（可多次调用）
    @method(1)
    open(@borrowed self, path: BorrowedStr, flags: OpenFlags)
        -> result<Fd, FsError>;

    @method(2)
    close(@borrowed self, fd: Fd) -> result<unit, FsError>;

    @method(3)
    read(@borrowed self, fd: Fd, buf: Vec<u8>) -> result<i64, FsError>;

    @method(4)
    write(@borrowed self, fd: Fd, buf: Vec<u8>) -> result<i64, FsError>;

    // 转移所有权：销毁自身
    @method(5)
    destroy(@owned self) -> result<unit, FsError>;
}