@module kvstore @version 2

enum KvError : i32 {
    NotFound = 1
    Full = 2
}

struct Entry {
    key: u64
    val: u64
}

// 复杂数据结构：struct 字段直接内嵌 map / set（收敛为中间布局规范载体）
struct Bucket {
    id: u32
    items: Map<u64, u64>
    tags: Set<u32>
}

interface KvStore {
    @borrowed self
    get(@borrowed self, k: u64) -> result<u64, KvError>;
    @borrowed self
    put(@borrowed self, k: u64, v: u64) -> result<(), KvError>;
    // 返回关联容器
    @borrowed self
    snapshot(@borrowed self) -> result<Map<u64, u64>, KvError>;
    // 返回集合
    @borrowed self
    tags(@borrowed self) -> result<Set<u32>, KvError>;
    @method(5)
    destroy(@owned self) -> result<(), KvError>;
}
