function(xso_generate_config)
    set(CONFIG_FILE "${CMAKE_BINARY_DIR}/include/config.h")
    file(WRITE ${CONFIG_FILE} "/* Auto-generated. Do not edit. */\n#pragma once\n\n")

    file(APPEND ${CONFIG_FILE} "#define XSO_VERSION_MAJOR ${PROJECT_VERSION_MAJOR}\n")
    file(APPEND ${CONFIG_FILE} "#define XSO_VERSION_MINOR ${PROJECT_VERSION_MINOR}\n")
    file(APPEND ${CONFIG_FILE} "#define XSO_VERSION_PATCH ${PROJECT_VERSION_PATCH}\n")
    file(APPEND ${CONFIG_FILE} "#define XSO_VERSION_STR   \"${PROJECT_VERSION}\"\n")
    file(APPEND ${CONFIG_FILE} "#define XSO_ARCH_${XSO_ARCH} 1\n")
    file(APPEND ${CONFIG_FILE} "#define XSO_LOG_LEVEL ${XSO_LOG_LEVEL}\n")

    if (XSO_SMP)
        file(APPEND ${CONFIG_FILE} "#define CONFIG_SMP 1\n")
    endif()
    if (XSO_NET_STACK)
        file(APPEND ${CONFIG_FILE} "#define CONFIG_NET_STACK 1\n")
    endif()
    if (XSO_NET_TCP)
        file(APPEND ${CONFIG_FILE} "#define CONFIG_NET_TCP 1\n")
    endif()
    if (XSO_DRV_E1000)
        file(APPEND ${CONFIG_FILE} "#define CONFIG_DRIVER_E1000 1\n")
    endif()
    if (XSO_FS_EXT2)
        file(APPEND ${CONFIG_FILE} "#define CONFIG_FS_EXT2 1\n")
    endif()

    message(STATUS "Generated ${CONFIG_FILE}")
endfunction()
